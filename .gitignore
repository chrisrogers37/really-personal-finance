# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Keep .env.example committed
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local transaction CSVs (user-uploaded test data)
/transactions/

# Claude fleet bot telemetry — supervision hooks may write these relative to
# the session cwd instead of the bot directory (Claudfather/Claudlobby#874);
# they can land at any depth and are never product data.
**/data/events/fleet-*.jsonl
**/data/.last-tool-call
**/data/.idle
